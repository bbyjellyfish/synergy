guess = int(raw)
if not (MIN_NUM <= guess <= MAX_NUM):
print(f"Введите целое число в диапазоне {MIN_NUM}–
{MAX_NUM}.")
return None return guess
except ValueError:
print("Ошибка ввода: нужно целое число.") return None

