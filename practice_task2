import math # Подключаем библиотеку math, чтобы использовать готовую функцию factorial

def calculate_factorial(): try:
# Запрашиваем у пользователя число
num = int(input("Введите положительное целое число: "))


# Проверяем, что число не отрицательное if num < 0:
print("Ошибка: число должно быть положительным.") return

# Считаем факториал с помощью math.factorial (оптимизированный способ)
result = math.factorial(num)


# Выводим результат
print(f"Факториал числа {num} равен {result}")


except ValueError:
# Если пользователь ввёл не число
print("Ошибка: введите корректное целое число.")


# Запуск программы
if 	name	== "	main	":
calculate_factorial()
